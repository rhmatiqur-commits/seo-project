# --- Supabase ---
# Project URL and keys: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon key isn't used server-side in Phase 1 (the admin app uses the service role key),
# but is included for when client-facing auth is added in a later phase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI provider ---
# AI_PROVIDER selects which lib/ai/*-provider.ts implementation is used.
# Only the selected provider's key is required.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# --- Admin UI ---
# Shared password gating the internal admin UI (Phase 1 has no per-user login yet).
ADMIN_PASSWORD=change-me

# --- Crawler (optional overrides; sensible defaults are hard-coded otherwise) ---
CRAWLER_USER_AGENT=SEOPlatformBot/0.1 (+https://example.com/bot)
